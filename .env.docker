# Production / Docker Environment Configuration
PORT=3000
NODE_ENV=production
PAYLOAD_LIMIT=50mb

# JWT Authentication
JWT_SECRET=Production_Super_Secret_Key_Change_Me_2026!

# Database Configuration (PostgreSQL 17 Multi-Schema via itest-network)
# Kết nối trực tiếp container itest-postgres của itest-database
DB_HOST=itest-postgres
DB_PORT=5432
DB_USERNAME=itest_system_user
DB_PASSWORD=system_secret_2026
DB_NAME=itest_platform
DB_SCHEMA=system_schema
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Dynamic Database Routing Configuration
DB_ROUTING_CONFIG_PATH=/app/config/db-routing.config.json

# Ops Agent Sidecar (chạy trên cùng itest-network)
OPS_AGENT_URL=http://itest_ops_agent:3099
OPS_AGENT_PORT=3099
