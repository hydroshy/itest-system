# ==============================================================================
# DAVITEQ LORAWAN PLATFORM - DOCKER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Usage:
#   docker compose --env-file .env.docker up -d
#   or copy to .env: cp .env.docker .env && docker compose up -d

# Application Server
PORT=3000
NODE_ENV=production
PAYLOAD_LIMIT=50mb

# Security & Authentication
JWT_SECRET=Production_Super_Secret_Key_Change_Me_2025!

# PostgreSQL Database Configuration
DB_HOST=postgres_db
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=mason
DB_NAME=dvt
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Configuration Paths
DB_ROUTING_CONFIG_PATH=/app/config/db-routing.config.json

# Ops Agent Service
OPS_AGENT_URL=http://ops_agent:3099
OPS_AGENT_PORT=3099
