# ==============================================================================
# ITEST MICRO-KERNEL CORE PLATFORM - DOCKER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Usage:
#   docker compose --env-file .env.docker up -d
#   or copy to .env: cp .env.docker .env && docker compose up -d

# Application Server
PORT=3000
NODE_ENV=production
PAYLOAD_LIMIT=50mb

# Security & Authentication
JWT_SECRET=Production_Super_Secret_Key_Change_Me_2026!

# PostgreSQL Database Configuration (connects to postgres_db container or itest_db)
DB_HOST=postgres_db
DB_PORT=5432
DB_USERNAME=itest_system_user
DB_PASSWORD=itest_system_secure_pass_2026
DB_NAME=itest_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Configuration Paths
DB_ROUTING_CONFIG_PATH=/app/config/db-routing.config.json

# Ops Agent Sidecar Service
OPS_AGENT_URL=http://ops_agent:3099
OPS_AGENT_PORT=3099
