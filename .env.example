# Application Configuration
PORT=3000
NODE_ENV=development
PAYLOAD_LIMIT=50mb

# JWT Authentication
JWT_SECRET=Your_Super_Secret_Key_Change_In_Production!

# Database Configuration (PostgreSQL 17 Multi-Schema from itest-database)
# Khi kết nối tới cụm itest-database (chạy Docker hoặc local):
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=itest_system_user
DB_PASSWORD=system_secret_2026
DB_NAME=itest_platform
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Dynamic Database Routing Configuration
DB_ROUTING_CONFIG_PATH=./config/db-routing.config.json

# Ops Agent Monitoring Sidecar
OPS_AGENT_URL=http://localhost:3099
OPS_AGENT_PORT=3099
