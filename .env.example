# ==============================================================================
# ITEST MICRO-KERNEL CORE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Server
PORT=3000
NODE_ENV=production
PAYLOAD_LIMIT=50mb

# Security & Authentication
JWT_SECRET=Production_Super_Secret_Key_Change_Me_2026!

# PostgreSQL Database Configuration (itest-database PostgreSQL 17)
# Maps to system_schema with dedicated service account itest_system_user
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=itest_system_user
DB_PASSWORD=itest_system_secure_pass_2026
DB_NAME=itest_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Dynamic Database Routing Configuration Path
DB_ROUTING_CONFIG_PATH=/app/config/db-routing.config.json

# Ops Agent Sidecar Service Integration
OPS_AGENT_URL=http://localhost:3099
OPS_AGENT_PORT=3099
