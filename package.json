{
  "name": "@itest/core-system",
  "version": "1.0.0",
  "description": "ITEST Micro-kernel Core Backbone & Application Server Platform with Dynamic PostgreSQL Table-to-DB Routing & RBAC",
  "author": "ITEST Platform Team",
  "private": true,
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "node -e \"try { require('fs').rmSync('dist', { recursive: true, force: true }); } catch(e) {}\"",
    "build": "nest build",
    "build:frontend": "pnpm --dir system-frontend run build",
    "build:all": "nest build && pnpm --dir system-frontend run build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "check-db": "ts-node src/check-db.ts",
    "test": "ts-node -r tsconfig-paths/register test/plugin-management-api.spec.ts && ts-node -r tsconfig-paths/register test/control-panel-render.spec.ts",
    "test:entities": "ts-node -r tsconfig-paths/register test/entity-metadata-verification.spec.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/typeorm": "^10.0.1",
    "@nestjs/websockets": "^10.4.22",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.20",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.0",
    "ts-node": "^10.9.2"
  }
}
